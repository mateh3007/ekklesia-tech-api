generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  USER
}

model Church {
  id            String             @id @default(uuid())
  corporateName String
  cnpj          String             @unique
  email         String
  phone         String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  permissions   ChurchPermission[]
}

model Permission {
  id          String             @id @default(uuid())
  name        String             @unique
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  churches    ChurchPermission[]
}

model ChurchPermission {
  id           String     @id @default(uuid())
  churchId     String
  permissionId String
  church       Church     @relation(fields: [churchId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([churchId, permissionId])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String
  role      Role
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

