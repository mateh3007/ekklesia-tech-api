generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  USER
}

model Church {
  id            String             @id @default(uuid())
  corporateName String
  cnpj          String             @unique
  email         String
  phone         String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  users         User[]
  permissions   ChurchPermission[]
  services      ChurchService[]
  events        ChurchEvent[]
  invites       ChurchInvite[]
}

model ChurchEvent {
  id          String   @id @default(uuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  title       String
  description String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChurchService {
  id          String   @id @default(uuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  title       String
  description String
  day         Day
  startsAt    String
  endsAt      String
  isOnline    Boolean  @default(false)
  streamUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String             @id @default(uuid())
  name        String             @unique
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  churches    ChurchPermission[]
}

model ChurchPermission {
  id           String     @id @default(uuid())
  churchId     String
  permissionId String
  church       Church     @relation(fields: [churchId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([churchId, permissionId])
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  password           String
  phone              String
  role               Role
  churchId           String
  church             Church               @relation(fields: [churchId], references: [id])
  passwordChangedAt  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  sentInvites         ChurchInvite[]       @relation("SentInvites")
}

model ChurchInvite {
  id            String       @id @default(uuid())
  churchId      String
  church        Church       @relation(fields: [churchId], references: [id])
  invitedBy     String
  invitedByUser User         @relation("SentInvites", fields: [invitedBy], references: [id])
  email         String
  token         String       @unique
  status        InviteStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

